# syntax=docker/dockerfile:1
# ============================================================
# hermes-base —— 公共基座镜像（统一工具链 / 统一路径 / 单一版本）
# ------------------------------------------------------------
# 派生两个镜像：
#   hermes-agent:main      (hermes 容器 : gateway / 渠道 / cron / MCP)
#   hermes-web-ui:<ver>    (webui 容器 : Ekko Studio UI + 网页聊天 agent)
#
# 统一约定（两端一致，禁止各镜像另装一份）：
#   agent-browser CLI  → /usr/local/bin/agent-browser （PATH 命中）
#   Chromium           → /opt/hermes/.playwright/chromium-<rev> （PLAYWRIGHT_BROWSERS_PATH）
#   Ekko Studio MCP    → /opt/ekko/bin/ekko-studio-mcp.mjs （自包含单文件）
#   ⚠ 禁止执行 agent-browser install（会在 $HOME/.agent-browser 再下第三份 Chrome）
# ============================================================
FROM nousresearch/hermes-agent:main

ARG NODE_VERSION=24.21.0
ARG PLAYWRIGHT_VERSION=1.62.0
ARG PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
ARG PIP_EXTRA_INDEX=https://pypi.org/simple
ARG NPM_REGISTRY=https://registry.npmmirror.com

ENV PIP_BREAK_SYSTEM_PACKAGES=1 \
    NODE_OPTIONS=--max-old-space-size=4096 \
    NPM_CONFIG_REGISTRY=${NPM_REGISTRY} \
    NODEJS_ORG_MIRROR=${NPM_REGISTRY}/-/binary/node \
    ELECTRON_MIRROR=${NPM_REGISTRY}/-/binary/electron/ \
    PYTHON_MIRROR=${NPM_REGISTRY}/-/binary/python/ \
    PLAYWRIGHT_BROWSERS_PATH=/opt/hermes/.playwright \
    CRAWL4AI_PLAYWRIGHT_BROWSERS_PATH=/opt/hermes/.playwright \
    NODE_PATH=/usr/lib/node_modules \
    HF_HOME=/opt/hermes/.whisper

USER root
WORKDIR /opt/hermes

# ============================================
# 1) apt 源 -> 阿里云
# ============================================
RUN if [ -f /etc/apt/sources.list ]; then \
        sed -i 's/deb.debian.org/mirrors.aliyun.com/g; s/security.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list; \
    elif [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i 's/deb.debian.org/mirrors.aliyun.com/g; s/security.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources; \
    else \
        echo "no sources.list, skip"; \
    fi

# ============================================
# 2) 系统依赖（一次装齐、已去重；含 Chromium 运行时库）
# ============================================
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        build-essential \
        curl \
        wget \
        make \
        g++ \
        ffmpeg \
        libnss3 \
        libatk-bridge2.0-0 \
        libdrm2 \
        libxkbcommon0 \
        libgbm1 \
        libasound2 \
        dbus \
        libgtk-3-0 \
        socat \
        gh \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ============================================
# 2.1) git 走 SSH（本机 HTTPS 到 github.com 被按域名阻断，SSH:22 与 ssh.github.com:443 可用）
#      不改写法的话 git clone/push、gh repo clone 会全部卡死到超时；
#      此处做全局前缀改写：任何 https://github.com/… 自动变成 git@github.com:…
#      前置：需已注册 SSH key（见技能 devops/github-restricted-access）
# ============================================
RUN git config --system url."git@github.com:".insteadOf "https://github.com/" \
 && git config --system --add url."git@github.com:".insteadOf "git://github.com/" \
 && git config --system --list | grep -c 'git@github.com'

# ============================================
# 3) Node.js（唯一版本，24.x）
# ============================================
RUN ARCH=$(dpkg --print-architecture) \
    && case "$ARCH" in amd64) NODE_ARCH=x64;; arm64) NODE_ARCH=arm64;; *) NODE_ARCH=$ARCH;; esac \
    && curl -fsSL "https://mirrors.huaweicloud.com/nodejs/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.gz" -o /tmp/node.tar.gz \
       || curl -fsSL "https://registry.npmmirror.com/-/binary/node/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.gz" -o /tmp/node.tar.gz \
    && rm -rf /usr/local/lib/node_modules /usr/local/bin/node /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
    && tar -xzf /tmp/node.tar.gz -C /usr/local --strip-components=1 \
    && rm -f /tmp/node.tar.gz \
    && apt-get update && apt-get install -y python3-pip && rm -rf /var/lib/apt/lists/* \
    && npm config set registry ${NPM_REGISTRY} \
    && node --version && npm --version

# ============================================
# 4) Python 环境与依赖
RUN python3 -m venv /opt/hermes/.venv
RUN /opt/hermes/.venv/bin/pip install \
        --index-url ${PIP_INDEX} \
        --extra-index-url ${PIP_EXTRA_INDEX} \
        --no-cache-dir \
        -e /opt/hermes \
        'firecrawl-py>=4.37.0'

# 固化 lazy_deps 的两处版本 pin（消除启动期 lazy-refresh 竞态）
RUN sed -i 's/edge-tts==7\.2\.7/edge-tts==7.2.8/g' /opt/hermes/tools/lazy_deps.py && \
    sed -i 's/firecrawl-py==4\.17\.0/firecrawl-py>=4.17.0,<5/' /opt/hermes/tools/lazy_deps.py && \
    grep -q 'edge-tts==7.2.8' /opt/hermes/tools/lazy_deps.py

RUN uv pip install --python /opt/hermes/.venv/bin/python3 \
        --index-url ${PIP_INDEX} \
        -e /opt/hermes \
        'qdrant-client>=1.19.0' \
        'psycopg[binary]>=3.2.0' \
        'lark-oapi>=1.6.8' \
        'qrcode>=7.4.2' \
        'dingtalk-stream>=0.24.3' \
        'alibabacloud-dingtalk>=2.2.49' \
        "playwright==${PLAYWRIGHT_VERSION}" \
        'websocket-client>=1.9.0'

# 2026-09-20：crawl4ai 钉版 ≥0.9.0。
#   0.6.3 存在 7 条 CRITICAL + 6 条 HIGH（未认证 RCE / 任意文件写 / SSRF / 凭据外泄等），
#   修复版见 OSV：0.8.0 / 0.8.7 / 0.9.0（本轮全量审计发现）。
#   说明：本栈未启用 crawl4ai 插件（config.yaml plugins.enabled 无它）、也无代码 import 它，
#   该包来自 plugin-catalog 的社区插件 hermes-plugin-crawl4ai（需外部 CRAWL4AI_URL 实例）；
#   保留包体但钉到已修复版本，若确认永不使用可整行删除。
# ============================================

RUN uv pip install --python /opt/hermes/.venv/bin/python3 \
        --index-url ${PIP_EXTRA_INDEX} \
        --extra-index-url ${PIP_INDEX} \
        --index-strategy unsafe-best-match \
        'crawl4ai>=0.9.3'

# 2026-09-20（安全审计第 2 轮）：把「能被安全钉版修掉」的两个包放到所有 pip 安装之后，
# 做一次**最终加固**（避免前面 crawl4ai 等安装把版本带回去）：
#   anyio>=4.14.2  —— 修复 GHSA-82r6-8w77-94w6（CRITICAL：TLSStream IDNA 2003 主机名编码 → 证书欺骗）
#   pip>=26.2.0    —— 修复 5 条 MODERATE（tar 解压路径穿越/符号链接等）
# 说明（刻意**不**钉的，理由已核实）：
#   httpx2 / httpcore2 —— 上游硬钉 `httpx2==2.7.0`（pyproject.toml:279/290、tools/lazy_deps.py:201），
#                        且 mcp 2.0 SDK 直接 `import httpx2`；改动会破坏上游约束与 MCP HTTP 栈 → 接受。
#   nltk 3.10.3        —— OSV 无修复版 → 接受（触发路径为"模型制品 API"，本栈不用）。
#   wheel 0.46.1       —— 系统包（Debian python3-wheel 0.46.1-2 已是源内最新，无 0.46.2）→ 接受。
RUN uv pip install --python /opt/hermes/.venv/bin/python3 \
        --index-url ${PIP_INDEX} \
        'anyio>=4.14.2' \
        'pip>=26.2.0'

# firecrawl-anydoc 为 Rust 原生包，pip 处理更好
RUN /opt/hermes/.venv/bin/pip install firecrawl-anydoc --index-url ${PIP_EXTRA_INDEX}

# 文档 / 办公 / 语音
RUN uv pip install --python /opt/hermes/.venv/bin/python3 \
        --index-url ${PIP_INDEX} \
        'openpyxl>=3.1.5' \
        'python-docx>=1.1.0' \
        'python-pptx>=1.0.2' \
        'defusedxml>=0.7.1' \
        'pymupdf>=1.24.0' \
        'Pillow>=10.0.0' \
        'lxml>=5.0.0' \
        'pandas>=2.0.0' \
        'xlsxwriter>=3.1.0' \
        'edge-tts>=7.2.8'

# MCP 客户端 / 视频转写
RUN uv pip install --python /opt/hermes/.venv/bin/python3 \
        --index-url ${PIP_INDEX} \
        mcp \
        'yt-dlp>=2024.12.13' \
        'faster-whisper>=1.1.0'

# ============================================
# 5) 全局 npm 工具（含 agent-browser；统一版本面）
# ============================================
RUN export PATH="/usr/local/bin:$PATH" && \
    npm install -g \
        @gitlawb/openclaude \
        reasonix \
        @firecrawl/anydoc \
        @marp-team/marp-cli \
        chrome-devtools-mcp \
        agent-browser \
        "playwright@${PLAYWRIGHT_VERSION}" \
        pptxgenjs \
        sharp \
        pdf-lib && \
    ln -sf /usr/local/bin/node /usr/bin/node && \
    ln -sf /usr/local/bin/npm /usr/bin/npm && \
    ln -sf /usr/local/bin/npx /usr/bin/npx && \
    agent-browser --version && \
    npm cache clean --force

# ============================================
# 5.1) codegraph —— 单装，且必须走官方源 registry.npmjs.org
# ------------------------------------------------------------
# 为什么不能并入上面那条、也不能用 npmmirror：
#   codegraph 的重物（~230MB 自包含 bundle）以 per-platform optionalDependency
#   @colbymchenry/codegraph-linux-x64 分发（esbuild 模式）。npmmirror 对该平台包
#   只镜像到 1.4.1（2026-09-15 查证），而主包 latest 已是 1.6.0 →
#   npm 把「取不到的可选依赖」视为成功、静默跳过（日志只 added 1 package）→
#   npm-shim 回落到 GitHub Releases 下载（本机 github.com 被阻断）→ 连接超时 →
#   `codegraph --version` 返回非 0 → 整层构建失败。
#   registry.npmjs.org 直连实测可用（HTTP 200；装包 ~12s；added 2 packages），故单独指定。
# 校验方式：CODEGRAPH_NO_DOWNLOAD=1 + 一个空的 CODEGRAPH_INSTALL_DIR
#   —— 强制只用 npm 包自带的 bundle：不读 /root/.codegraph 缓存、不许联网兜底。
#      平台包真缺了立即非 0 退出，不会「偷偷下载成功」而假通过。
# 应急：若日后 npmjs 不可达（代理没开 / 网络收紧），可改为 pin npmmirror 已镜像的版本
#   （@colbymchenry/codegraph@1.4.1）或给构建挂代理——两条路都只改这一行。
# ============================================
RUN export PATH="/usr/local/bin:$PATH" && \
    npm install -g @colbymchenry/codegraph --registry=https://registry.npmjs.org && \
    ln -sf "$(npm root -g)/@colbymchenry/codegraph/npm-shim.js" /usr/local/bin/codegraph && \
    CODEGRAPH_NO_DOWNLOAD=1 CODEGRAPH_INSTALL_DIR=/tmp/codegraph-verify codegraph --version && \
    rm -rf /tmp/codegraph-verify

# ============================================
# 5.2) 编码工具链固化：OpenCodeReview(ocr) + Reasonix 运行环境
# ------------------------------------------------------------
# 为什么单独一装、且必须 --registry=https://registry.npmjs.org：
#   @alibaba-group/open-code-review 与 codegraph 同款 —— 平台二进制走
#   per-platform optionalDependency（@alibaba-group/ocr-linux-x64 等），而镜像里
#   NPM_CONFIG_REGISTRY=https://registry.npmmirror.com 常漏镜像平台包 →
#   npm 把「取不到的可选依赖」当成功静默跳过 → 运行时报缺二进制。
#   官方源实测可直连（装完 ocr --version 正常）。
# 为什么配置不写进镜像：
#   /opt/data 是持久卷（compose opt_data_volume），构建期写在里面的东西运行时会被
#   卷遮蔽 → 白写。故镜像只放「模板 + 引导脚本」，密钥在容器启动时由环境变量注入
#   （DEEPSEEK_API_KEY，两个容器均已注入），见 coding-agents/bootstrap.sh。
# ============================================
ENV REASONIX_HOME=/opt/data/reasonix
RUN export PATH="/usr/local/bin:$PATH" && \
    npm install -g @alibaba-group/open-code-review@1.12.7 \
        --registry=https://registry.npmjs.org && \
    ocr --version && \
    npm cache clean --force

COPY coding-agents/bootstrap.sh coding-agents/run-bootstrap.sh coding-agents/reasonix-config.toml /opt/hermes/coding-agents/
RUN chmod +x /opt/hermes/coding-agents/bootstrap.sh /opt/hermes/coding-agents/run-bootstrap.sh && \
    rm -rf /root/.reasonix /root/.opencodereview && \
    ln -s /opt/data/reasonix /root/.reasonix && \
    ln -s /opt/data/opencodereview /root/.opencodereview

# ============================================
# 5.3) LoopX —— 长周期 agent 控制平面 CLI（2026-09-21）
# ------------------------------------------------------------
# 是什么：开源（Apache-2.0，loopx-project/loopx）的「loop engineering」控制平面，
#   跑在 Codex / Claude Code / OpenCode / KunlunCode 之上执行有界的一步，
#   自己管 goal / gate / todo / evidence / quota / handoff 的**耐久状态**；
#   Hermes 只当调度与渠道，不替代它执行。
# 为什么进基座：与 openclaude / reasonix / ocr 同一约定 —— 工具链统一在 hermes-base，
#   派生镜像禁止另装一份（见本文件头注释）。
# 为什么用 ${PIP_EXTRA_INDEX}(pypi.org) 而非 ${PIP_INDEX}(tuna)：
#   实测 tuna 索引对本包滞后（uv 只解析到 1.0.0），1.1.0 仅在官方源可取。
# 为什么要软链到 /usr/local/bin：
#   `docker exec hermes bash -lc 'loopx ...'` 的登录 shell 会重置 PATH，
#   /opt/hermes/.venv/bin 不在其中（实测 command not found）→ 软链到 /usr/local/bin
#   （与 npm 全局工具同一目录，agent 侧调用零配置）。
# 状态目录（实测）：
#   全局注册表 ~/.codex/loopx/registry.global.json（由 compose 挂持久卷保住）；
#   项目内    <project>/.loopx/registry.json + <project>/.codex/goals/<goal>/ACTIVE_GOAL_STATE.md
#             → 需把 .loopx/ 与 .codex/goals/ 写进项目 .gitignore（loopx 自身也会提示）。
# wheel 另带入口：loopx-kunluncode / loopx-lark-provider / loopx-openviking-*
# ============================================
RUN /opt/hermes/.venv/bin/pip install --no-cache-dir \
        --index-url ${PIP_EXTRA_INDEX} \
        'loopx==1.1.0' && \
    ln -sf /opt/hermes/.venv/bin/loopx /usr/local/bin/loopx && \
    loopx --version && \
    command -v loopx

# ============================================
# 6) Chromium（单一 revision；两容器共用 PLAYWRIGHT_BROWSERS_PATH）
# ============================================
RUN mkdir -p /opt/hermes/.playwright && \
    echo "=== Installing Chromium (single revision) ===" && \
    ( PLAYWRIGHT_BROWSERS_PATH=/opt/hermes/.playwright \
      PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright \
      /opt/hermes/.venv/bin/python3 -m playwright install chromium || \
      PLAYWRIGHT_BROWSERS_PATH=/opt/hermes/.playwright \
      PLAYWRIGHT_DOWNLOAD_HOST=${NPM_REGISTRY}/-/binary/playwright \
      /opt/hermes/.venv/bin/python3 -m playwright install chromium || \
      PLAYWRIGHT_BROWSERS_PATH=/opt/hermes/.playwright \
      /opt/hermes/.venv/bin/python3 -m playwright install chromium ) && \
    CHROME_PATH=$(find /opt/hermes/.playwright -name chrome -type f 2>/dev/null | head -1) && \
    if [ -n "$CHROME_PATH" ]; then \
        echo "Chromium: $CHROME_PATH"; $CHROME_PATH --version 2>/dev/null || true; \
    else \
        echo "Chromium not found"; ls -la /opt/hermes/.playwright/; exit 1; \
    fi && \
    ls -d /opt/hermes/.playwright/chromium-* 2>/dev/null

# ============================================
# 6.1) 清除上游基座残留的旧 Chromium revision（保持单一版本）
# ============================================
RUN CHROMIUM_REV=$(/opt/hermes/.venv/bin/python3 -c "import json,glob;print(next(b['revision'] for p in glob.glob('/opt/hermes/.venv/**/playwright/driver/package/browsers.json',recursive=True) for b in json.load(open(p))['browsers'] if b['name']=='chromium'))") && \
    echo "expected chromium revision: $CHROMIUM_REV" && \
    for d in /opt/hermes/.playwright/chromium-* /opt/hermes/.playwright/chromium_headless_shell-*; do \
        [ -d "$d" ] || continue; \
        case "$d" in *-"$CHROMIUM_REV") echo "keep $d" ;; *) echo "remove stale $d"; rm -rf "$d" ;; esac; \
    done && \
    ls -la /opt/hermes/.playwright/

# ============================================
# 6.2) dev-browser（SawyerHood/dev-browser, MIT）—— 包 + daemon 依赖一起固化进镜像
# ------------------------------------------------------------
# 背景（用户实测反馈）：原先它只装在共享卷（/opt/data/npm-global），而 $HOME/.dev-browser（25MB）
#   与它自带的 chromium-1208（~110MB）都落在**容器层** → 每次 recreate 都要重装 + 重下 110MB。
# 做法：
#   ① 包钉 0.2.9 装进镜像（官方源；该包纯 JS，无 per-platform 陷阱）
#   ② 用 DEV_BROWSER_CHROME 指镜像内 Chromium：决定**运行时**用哪个 Chrome（本栈与 CDP Chrome 统一到 chromium-1234）。
#      注意（实测）：`install` **仍会**拉它自带 playwright 的 chromium-1208（~110MB）——DEV_BROWSER_CHROME 拦不住它。
#      这正是要固化进镜像的原因：**只在构建期付一次**，之后每次 recreate 都不再重装/重下。
#   ③ 复制一份到 /home/agent/.dev-browser：webui 容器 HOME=/home/agent，否则那边仍会自装
#   ④ 清掉 daemon.pid / daemon.sock / daemon-spawn.lock：运行时残留不该进镜像
# ============================================
RUN npm install -g dev-browser@0.2.9 --registry=https://registry.npmjs.org && \
    DEV_BROWSER_CHROME="$(ls -d /opt/hermes/.playwright/chromium-*/chrome-linux64/chrome | sort -V | tail -1)" && \
    echo "dev-browser 使用 Chromium: $DEV_BROWSER_CHROME" && \
    DEV_BROWSER_CHROME="$DEV_BROWSER_CHROME" dev-browser install && \
    test -s /root/.dev-browser/daemon.mjs && \
    rm -f /root/.dev-browser/daemon.pid /root/.dev-browser/daemon.sock /root/.dev-browser/daemon-spawn.lock && \
    mkdir -p /home/agent && cp -a /root/.dev-browser /home/agent/.dev-browser && \
    (chown -R 10000:10000 /home/agent/.dev-browser 2>/dev/null || true) && \
    ls -d /root/.dev-browser /home/agent/.dev-browser && \
    du -sh /root/.dev-browser

# ============================================
# 7) Ekko Studio MCP（自包含单文件，两容器共用；不再依赖宿主 /app）
# ============================================
COPY app/bin/ekko-studio-mcp.mjs app/bin/hermes-studio-mcp.mjs app/bin/hermes-web-ui-mcp.mjs /opt/ekko/bin/
COPY app/package.json /opt/ekko/package.json
# CRLF 归一：源 app/bin/*.mjs 由 Ekko 构建生成，恒为 CRLF；直接执行报 env: 'node\r'
RUN sed -i 's/\r$//' /opt/ekko/bin/*.mjs && \
    node --check /opt/ekko/bin/ekko-studio-mcp.mjs && \
    echo "Ekko MCP installed at /opt/ekko/bin"

# ============================================
# 8) 技能 / 工具链固化（装镜像内，避开卷遮蔽）
# ============================================
# 8.1 AgentChat 框架（skills 由 entrypoint 链入共享卷，故两容器都要有本体）
COPY agentchat-framework/ /opt/agentchat/
RUN cd /opt/agentchat && \
    npm install --no-audit --no-fund && \
    (cd skills/AgentChat-OneWeb && npm install --no-audit --no-fund) && \
    test -d /opt/agentchat/node_modules && \
    test -d /opt/agentchat/skills/AgentChat-OneWeb/node_modules && \
    echo "AgentChat deps ok"

# 8.2 Serena
RUN python3 -m venv /opt/serena-venv && \
    /opt/serena-venv/bin/pip install -i ${PIP_INDEX} 'serena-agent==1.6.1' && \
    HOME=/home/agent /opt/serena-venv/bin/serena init

# 8.3 book-to-skill（未上 PyPI，源码安装）
COPY book-to-skill/ /opt/book-to-skill/
RUN uv pip install --python /opt/hermes/.venv/bin/python3 \
        --index-url ${PIP_INDEX} \
        '/opt/book-to-skill[pdf,epub,docx,html,rtf]'

# 8.4 archify（Node CLI 零依赖）
COPY archify-src/archify/ /opt/archify/
RUN ln -sf /opt/archify/bin/archify.mjs /usr/local/bin/archify && \
    chmod +x /opt/archify/bin/archify.mjs

# 8.5 AI-Video-Transcriber + whisper 模型（构建期 COPY，零网络依赖）
COPY ai-video-transcriber/ /opt/ai-video-transcriber/
COPY whisper-model/ /opt/hermes/.whisper/

COPY sqlite-autoconf-3530400.tar.gz /tmp/
RUN set -eu; \
    echo "📦 Starting SQLite compilation..."; \
    if [ ! -f /tmp/sqlite-autoconf-3530400.tar.gz ]; then \
        echo "❌ SQLite tarball not found!"; \
        echo "⚠️ Installing SQLite from apt as fallback..."; \
        apt-get update && apt-get install -y sqlite3 libsqlite3-dev && \
        sqlite3 --version && \
        exit 0; \
    fi; \
    tar xzf /tmp/sqlite-autoconf-3530400.tar.gz -C /tmp; \
    cd /tmp/sqlite-autoconf-3530400; \
    ./configure --prefix=/usr/local --all; \
    make -j$(nproc) && make install; \
    ldconfig; \
    sqlite3 --version; \
    /opt/hermes/.venv/bin/python3 -c \
        "import sqlite3; v=sqlite3.sqlite_version; print(f'✅ SQLite upgraded: {v}'); assert v>='3.51.3'"; \
    rm -rf /tmp/sqlite-autoconf-*

# 8.6 CJK FTS5 扩展（镜像内 /usr/local/lib）
RUN cd /opt/hermes/native/fts5_cjk && \
    gcc -shared -fPIC -O2 -Wall -I/usr/local/include fts5_cjk.c -o libfts5_cjk.so && \
    install -m 0644 libfts5_cjk.so /usr/local/lib/libfts5_cjk.so

# ============================================
# 9) SQLite 版本核验（基础镜像已自带新版；不再编译，避免降级）
# ============================================
RUN /opt/hermes/.venv/bin/python3 -c \
        "import sqlite3,sys; v=sqlite3.sqlite_version; print('sqlite:',v); sys.exit(0 if v>='3.51.3' else 1)"

# ============================================
# 10) 路径 / 环境收尾
# ============================================
RUN mkdir -p /home/agent/.local/bin && \
    ln -sf /opt/hermes/.venv/bin/hermes /home/agent/.local/bin/hermes && \
    printf 'export PATH=/home/agent/.local/bin:$PATH\n' >> /home/agent/.bashrc && \
    printf 'export PYTHONPATH="/opt/hermes${PYTHONPATH:+:${PYTHONPATH}}"\n' >> /etc/profile.d/hermes.sh && \
    printf 'export PYTHONPATH="/opt/hermes${PYTHONPATH:+:${PYTHONPATH}}"\n' >> /home/agent/.bashrc

ENV PATH=/opt/hermes/.venv/bin:/home/agent/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/data/npm-global/bin
